{
  "name": "@snyk/cli-interface",
  "description": "Snyk CLI interface definitions",
  "homepage": "https://github.com/snyk/snyk-cli-interface",
  "bugs": {
    "url": "https://github.com/snyk/snyk-cli-interface/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/snyk/snyk-cli-interface.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "index.js",
  "files": [
    "**/*.d.ts",
    "**/*.js",
    "**/*.js.map",
    "!test/**"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tslint --project tsconfig.json --format stylish",
    "prepare": "npm run build",
    "test": "npm run build && npm run lint && node --test test/snyk-env.test.js"
  },
  "author": "snyk.io",
  "license": "Apache-2.0",
  "devDependencies": {
    "@snyk/dep-graph": "^2.9.0",
    "tslint": "^6",
    "typescript": "^3"
  },
  "dependencies": {
    "@types/graphlib": "^2"
  },
  "peerDependencies": {
    "@snyk/dep-graph": ">=1"
  }
}
